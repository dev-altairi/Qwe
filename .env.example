# GEMINI_API_KEY: Optional Gemini API Key
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# TWILIO_ACCOUNT_SID: Your Twilio Account SID for PSTN calling
# TWILIO_AUTH_TOKEN: Your Twilio Auth Token
